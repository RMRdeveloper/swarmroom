{
  "name": "@rmrdeveloper/swarmroom",
  "version": "4.0.3",
  "description": "A global Pi package that runs an isolated coding-agent pipeline through /swarmroom.",
  "type": "module",
  "files": [
    "dist",
    "src/assets",
    "skills"
  ],
  "scripts": {
    "build": "esbuild src/pi-extension.ts --bundle --platform=node --format=esm --outfile=dist/pi-extension.js --packages=external",
    "prepublishOnly": "npm run check && npm run build",
    "types": "tsc --noEmit",
    "test": "node --test src/core/agents.test.ts src/core/catalog.test.ts src/core/findings.test.ts src/core/grilling.test.ts src/core/orchestrator.test.ts src/pi-command.test.ts src/runtimes/pi.test.ts",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src package.json biome.json",
    "format:check": "biome format src package.json biome.json",
    "check": "npm run types && biome check src package.json biome.json && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "agents",
    "ai",
    "coding-agents",
    "multi-agent",
    "orchestration",
    "pi",
    "pi-package",
    "pi-sdk",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RMRdeveloper/swarmroom.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@biomejs/biome": "2.5.11",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
